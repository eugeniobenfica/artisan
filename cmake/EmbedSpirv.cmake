# Writes a SPIR-V file as a C++ array: cmake -DSPV=in.spv -DHDR=out.h -DVAR=name -P EmbedSpirv.cmake
file(READ ${SPV} bytes HEX)
string(LENGTH "${bytes}" len)
set(words "")
set(i 0)
while(i LESS len)
    # Little-endian 32-bit words.
    string(SUBSTRING "${bytes}" ${i} 8 w)
    string(SUBSTRING "${w}" 6 2 b3)
    string(SUBSTRING "${w}" 4 2 b2)
    string(SUBSTRING "${w}" 2 2 b1)
    string(SUBSTRING "${w}" 0 2 b0)
    string(APPEND words "0x${b3}${b2}${b1}${b0}u,")
    math(EXPR i "${i} + 8")
    math(EXPR col "${i} % 64")
    if(col EQUAL 0)
        string(APPEND words "\n")
    endif()
endwhile()
file(WRITE ${HDR} "// Generated from ${SPV}: do not edit.\n#pragma once\n#include <cstdint>\ninline constexpr uint32_t ${VAR}[] = {\n${words}\n};\n")
